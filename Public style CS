* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  background:
    linear-gradient(135deg, #eef6ff, #f7f4ff);
  color: #172033;
  min-height: 100vh;
}

.app {
  min-height: 100vh;
  max-width: 1100px;
  margin: auto;
  position: relative;
}

/* HEADER */

.header {
  height: 70px;
  padding: 10px 18px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  background: rgba(255,255,255,0.9);
  border-bottom: 1px solid #e5e7eb;

  position: sticky;
  top: 0;
  z-index: 10;

  backdrop-filter: blur(12px);
}

.brand {
  display: flex;
  align-items: center;
  gap: 11px;
}

.logo,
.welcome-logo {
  background:
    linear-gradient(135deg, #2563eb, #7c3aed);

  color: white;
  font-weight: bold;

  display: flex;
  align-items: center;
  justify-content: center;
}

.logo {
  width: 43px;
  height: 43px;
  border-radius: 14px;
  font-size: 21px;
}

.brand h1 {
  font-size: 19px;
}

.brand p {
  font-size: 11px;
  color: #64748b;
  margin-top: 3px;
}

.new-chat {
  border: 1px solid #dbe3ef;
  background: white;
  padding: 9px 13px;
  border-radius: 10px;
  cursor: pointer;
  font-weight: 600;
}

.new-chat:hover {
  background: #f1f5f9;
}

/* CHAT */

.chat-area {
  padding: 25px 15px 150px;
}

.welcome {
  text-align: center;
  max-width: 700px;
  margin: 50px auto;
}

.welcome-logo {
  width: 78px;
  height: 78px;
  margin: auto;
  border-radius: 25px;
  font-size: 36px;
  box-shadow: 0 15px 35px rgba(37,99,235,.2);
}

.welcome h2 {
  font-size: 29px;
  margin-top: 20px;
}

.welcome p {
  color: #64748b;
  line-height: 1.6;
  margin-top: 9px;
}

.suggestions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-top: 28px;
}

.suggestions button {
  text-align: left;
  background: white;
  border: 1px solid #e2e8f0;
  border-radius: 15px;
  padding: 15px;
  cursor: pointer;
  font-size: 14px;
}

.suggestions button:hover {
  border-color: #93c5fd;
  transform: translateY(-1px);
}

/* MESSAGES */

.message {
  max-width: 850px;
  margin: 0 auto 18px;

  display: flex;
  gap: 10px;
}

.message.user {
  justify-content: flex-end;
}

.avatar {
  width: 36px;
  height: 36px;
  min-width: 36px;

  border-radius: 11px;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 13px;
  font-weight: bold;
}

.ai-avatar {
  color: white;
  background: linear-gradient(135deg,#2563eb,#7c3aed);
}

.user-avatar {
  color: #334155;
  background: #e2e8f0;
  order: 2;
}

.bubble {
  max-width: 80%;
  padding: 13px 16px;

  border-radius: 17px;

  line-height: 1.6;
  font-size: 15px;

  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.ai-bubble {
  background: white;
  border: 1px solid #e2e8f0;
  border-top-left-radius: 5px;
}

.user-bubble {
  color: white;
  background: linear-gradient(135deg,#2563eb,#4f46e5);
  border-top-right-radius: 5px;
}

/* TYPING */

.typing {
  display: flex;
  gap: 5px;
}

.typing span {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #64748b;

  animation: typing 1s infinite;
}

.typing span:nth-child(2) {
  animation-delay: .15s;
}

.typing span:nth-child(3) {
  animation-delay: .3s;
}

@keyframes typing {

  0%, 60%, 100% {
    transform: translateY(0);
  }

  30% {
    transform: translateY(-6px);
  }
}

/* INPUT */

.input-area {
  position: fixed;
  bottom: 0;
  left: 50%;

  transform: translateX(-50%);

  width: min(1100px, 100%);

  padding: 12px 15px 18px;

  background:
    linear-gradient(
      to top,
      #f7f9fc 75%,
      transparent
    );
}

.input-box {
  max-width: 850px;
  margin: auto;

  display: flex;
  align-items: flex-end;
  gap: 8px;

  background: white;

  border: 1px solid #dbe3ef;
  border-radius: 20px;

  padding: 8px;

  box-shadow:
    0 10px 35px rgba(15,23,42,.12);
}

textarea {
  flex: 1;

  border: none;
  outline: none;

  resize: none;

  min-height: 45px;
  max-height: 140px;

  padding: 12px 10px;

  font-family: inherit;
  font-size: 15px;
}

.send-btn {
  width: 45px;
  height: 45px;

  border: none;
  border-radius: 14px;

  color: white;

  background:
    linear-gradient(135deg,#2563eb,#7c3aed);

  font-size: 18px;

  cursor: pointer;
}

.send-btn:disabled {
  opacity: .5;
}

.notice {
  text-align: center;

  font-size: 10px;

  color: #94a3b8;

  margin-top: 7px;
}

/* MOBILE */

@media(max-width:600px) {

  .header {
    height: 62px;
  }

  .logo {
    width: 38px;
    height: 38px;
  }

  .brand h1 {
    font-size: 17px;
  }

  .new-chat {
    font-size: 11px;
    padding: 8px;
  }

  .welcome {
    margin: 30px auto;
  }

  .welcome h2 {
    font-size: 24px;
  }

  .suggestions {
    grid-template-columns: 1fr;
  }

  .bubble {
    max-width: 82%;
    font-size: 14px;
  }

}
